{
  "info": {
    "_postman_id": "b0a6cf90-e593-41bb-92d1-localfix-phase5",
    "name": "LocalFix - Phase 5 Report REST API",
    "description": "Postman Collection for LocalFix Report REST API (Phase 5). Includes CRUD endpoints, query filtering, and negative validation tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "reportId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Checks",
      "item": [
        {
          "name": "Application Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          }
        },
        {
          "name": "Database Health (MySQL)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health/db",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health", "db"]
            }
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "1. Create New Report (Success - 201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Deep pothole on Main Street near 5th Avenue\",\n  \"description\": \"There is a dangerous, large pothole in the right traffic lane right outside the grocery store. Causing tire damage to passing cars.\",\n  \"category\": \"ROADS\",\n  \"severity\": \"HIGH\",\n  \"location\": \"Corner of Main St and 5th Ave\",\n  \"imageUrl\": \"https://images.unsplash.com/photo-1515162816999-a0c47dc192f7?w=800\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reports",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports"]
            }
          }
        },
        {
          "name": "2. Create Report (Validation Error - 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"\",\n  \"description\": \"Too short\",\n  \"category\": null,\n  \"location\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reports",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports"]
            }
          }
        },
        {
          "name": "3. Get All Reports (Newest First - 200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reports",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports"]
            }
          }
        },
        {
          "name": "4. Filter Reports by Category (ROADS)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reports?category=ROADS",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports"],
              "query": [
                {
                  "key": "category",
                  "value": "ROADS"
                }
              ]
            }
          }
        },
        {
          "name": "5. Filter Reports by Status (PENDING)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reports?status=PENDING",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports"],
              "query": [
                {
                  "key": "status",
                  "value": "PENDING"
                }
              ]
            }
          }
        },
        {
          "name": "6. Filter Reports by Category and Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reports?category=GARBAGE&status=IN_PROGRESS",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports"],
              "query": [
                {
                  "key": "category",
                  "value": "GARBAGE"
                },
                {
                  "key": "status",
                  "value": "IN_PROGRESS"
                }
              ]
            }
          }
        },
        {
          "name": "7. Get Report by ID (Success - 200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reports/{{reportId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "{{reportId}}"]
            }
          }
        },
        {
          "name": "8. Get Report by Non-Existent ID (Not Found - 404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reports/99999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "99999"]
            }
          }
        },
        {
          "name": "9. Partially Update Report (PATCH - 200)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"severity\": \"HIGH\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reports/{{reportId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "{{reportId}}"]
            }
          }
        }
      ]
    }
  ]
}
