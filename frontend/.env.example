# LocalFix Frontend Configuration
# -----------------------------------------------------------------------------
# IMPORTANT SECURITY NOTE:
# Variables prefixed with VITE_ are embedded into the client-side JavaScript
# bundle by Vite and exposed publicly to anyone inspecting the browser.
# NEVER place database passwords, private keys, or server secrets here!
# -----------------------------------------------------------------------------

# Base URL for the Spring Boot REST API
VITE_API_BASE_URL=http://localhost:8080/api
